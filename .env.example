# Base de datos (la misma Supabase Postgres que ya usas)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Supabase Storage (para subir imágenes de productos)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key

# Cloudflare R2 (imágenes — egress gratis, 10 GB free tier)
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key
R2_SECRET_ACCESS_KEY=tu-secret-key
R2_BUCKET_NAME=casaycosas-images
R2_PUBLIC_URL=https://images.casaycosas.qzz.io

# Panel de administración
ADMIN_PASSWORD=elige-una-contrasena-segura
# Clave secreta para firmar la sesión del admin (cualquier texto largo y aleatorio)
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Rate-limit de login (creá un Redis free en upstash.com)
UPSTASH_REDIS_REST_URL=https://xxx-xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# Email de pedidos (creá una cuenta free en resend.com)
# Sin estas vars no se envían emails pero todo lo demás funciona
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev

# URL pública del sitio (para OpenGraph/metadata). Sin slash final.
NEXT_PUBLIC_SITE_URL=https://casaycosas-next.vercel.app

# Datos de contacto de la tienda
NEXT_PUBLIC_WHATSAPP_NUMBER=56992139709
NEXT_PUBLIC_WHATSAPP_CATALOG_URL=https://wa.me/c/56992139709
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/casaycosas.panguipulli/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/people/Tienda-Casa-y-Cosas-Panguipulli/61582181283916/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@tiendacasaycosas
NEXT_PUBLIC_MAPS_URL=https://maps.app.goo.gl/t4b9KeWEd7U4MDPc6
NEXT_PUBLIC_STORE_ADDRESS=Martínez de Rosas 498, Local C, Panguipulli
